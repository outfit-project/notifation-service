VESTIS_NETWORK=vestis-services
NOTIFICATION_PORT=8004
MAILPIT_PORT=8025
# Isolated mode. With auth: redis://vestis-auth-redis:6379/0
REDIS_URL=redis://notification-redis:6379/0
MAIL_STREAM=mail:outbox
MAIL_GROUP=notifications
# Leave MAIL_CONSUMER unset to generate a unique consumer identity.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAIL_FROM=Vestis <hello@vestis.local>
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_IDLE_MS=60000
SMTP_TIMEOUT=10
