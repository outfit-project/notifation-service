REDIS_URL=redis://auth-redis:6379/0
MAIL_STREAM=mail:outbox
MAIL_GROUP=notification
# Leave MAIL_CONSUMER unset to generate a unique consumer identity.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAIL_FROM=Vestis <noreply@vestis.local>
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_IDLE_MS=60000
SMTP_TIMEOUT=10
